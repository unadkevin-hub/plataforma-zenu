<%- include('../partials/cabecera') %>
<nav aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/facilitador">Contenidos</a></li><li class="breadcrumb-item active" aria-current="page"><%= titulo %></li></ol></nav>
<h1 class="h3 mb-3"><%= titulo %></h1>
<%- include('../partials/errores', { errores }) %>
<form method="post" action="<%= accion %>" class="tarjeta p-4" style="max-width:720px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="mb-3"><label class="form-label" for="titulo">Título</label><input id="titulo" name="titulo" class="form-control" value="<%= m.titulo || '' %>" required maxlength="120"></div>
  <div class="mb-3"><label class="form-label" for="area_digcomp">Área DigComp 2.2</label><input id="area_digcomp" name="area_digcomp" class="form-control" value="<%= m.area_digcomp || '' %>" required maxlength="80" list="areas">
    <datalist id="areas"><option value="Alfabetización en información y datos"><option value="Comunicación y colaboración"><option value="Creación de contenidos digitales"><option value="Seguridad"><option value="Resolución de problemas"></datalist></div>
  <div class="mb-3"><label class="form-label" for="descripcion">Descripción</label><textarea id="descripcion" name="descripcion" class="form-control" rows="3" maxlength="400" required><%= m.descripcion || '' %></textarea></div>
  <div class="row"><div class="col-6 mb-3"><label class="form-label" for="orden">Orden</label><input id="orden" name="orden" type="number" min="1" class="form-control" value="<%= m.orden || 1 %>"></div>
  <div class="col-6 mb-3 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="publicado" value="si" id="publicado" <%= m.publicado ? 'checked' : '' %>><label class="form-check-label" for="publicado">Publicado (visible para estudiantes)</label></div></div></div>
  <button class="btn btn-primary">Guardar</button>
  <a class="btn btn-link" href="/facilitador">Cancelar</a>
</form>
<% if (m.id_modulo) { %>
<form method="post" action="/facilitador/modulos/<%= m.id_modulo %>/eliminar" class="mt-3 confirmar" data-confirmar="¿Eliminar el módulo con todas sus lecciones y actividades?">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button class="btn btn-outline-danger btn-sm">Eliminar módulo</button>
</form>
<% } %>
<%- include('../partials/pie') %>
