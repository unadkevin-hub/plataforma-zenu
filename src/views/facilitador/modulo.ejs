<%- include('../partials/cabecera') %>
<nav aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/facilitador">Contenidos</a></li><li class="breadcrumb-item active" aria-current="page"><%= m.titulo %></li></ol></nav>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
  <h1 class="h3 mb-0"><%= m.titulo %> <span class="badge fs-6 <%= m.publicado ? 'text-bg-success' : 'text-bg-secondary' %>"><%= m.publicado ? 'Publicado' : 'Borrador' %></span></h1>
  <div class="d-flex gap-2"><a class="btn btn-outline-dark" href="/facilitador/modulos/<%= m.id_modulo %>/editar">Editar módulo</a><a class="btn btn-primary" href="/facilitador/modulos/<%= m.id_modulo %>/lecciones/nueva">+ Nueva lección</a></div>
</div>
<p><%= m.descripcion %></p>
<div class="table-responsive tarjeta">
<table class="table mb-0 align-middle">
  <thead><tr><th>Orden</th><th>Lección</th><th>Actividades</th><th>Estado</th><th></th></tr></thead>
  <tbody>
  <% lecciones.forEach(function(l){ %>
  <tr><td><%= l.orden %></td><td><a class="fw-semibold" href="/facilitador/lecciones/<%= l.id_leccion %>"><%= l.titulo %></a><div class="small text-body-secondary"><%= l.resumen %></div></td>
  <td><%= l.n_actividades %></td><td><span class="badge <%= l.publicado ? 'text-bg-success' : 'text-bg-secondary' %>"><%= l.publicado ? 'Publicada' : 'Borrador' %></span></td>
  <td><a class="btn btn-sm btn-outline-dark" href="/facilitador/lecciones/<%= l.id_leccion %>/editar">Editar</a></td></tr>
  <% }) %>
  <% if (!lecciones.length) { %><tr><td colspan="5">Este módulo aún no tiene lecciones.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/pie') %>
