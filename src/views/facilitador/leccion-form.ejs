<%- include('../partials/cabecera') %>
<nav aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/facilitador">Contenidos</a></li><li class="breadcrumb-item"><a href="/facilitador/modulos/<%= m.id_modulo %>"><%= m.titulo %></a></li><li class="breadcrumb-item active" aria-current="page"><%= titulo %></li></ol></nav>
<h1 class="h3 mb-3"><%= titulo %></h1>
<%- include('../partials/errores', { errores }) %>
<form method="post" action="<%= accion %>" class="tarjeta p-4">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="mb-3"><label class="form-label" for="titulo">Título</label><input id="titulo" name="titulo" class="form-control" value="<%= l.titulo || '' %>" required maxlength="150"></div>
  <div class="mb-3"><label class="form-label" for="resumen">Resumen (una línea)</label><input id="resumen" name="resumen" class="form-control" value="<%= l.resumen || '' %>" required maxlength="300"></div>
  <div class="mb-3"><label class="form-label" for="contenido">Contenido</label>
    <textarea id="contenido" name="contenido" class="form-control font-monospace" rows="14" required aria-describedby="ayuda-contenido"><%= l.contenido || '' %></textarea>
    <div id="ayuda-contenido" class="form-text">Deja una línea en blanco entre párrafos. Empieza una línea con <code>## </code> para un subtítulo y con <code>- </code> para una viñeta.</div></div>
  <div class="mb-3"><label class="form-label" for="url_video">Video de apoyo (opcional, enlace de YouTube)</label><input id="url_video" name="url_video" class="form-control" value="<%= l.url_video || '' %>" placeholder="https://www.youtube.com/watch?v=..."><div class="form-text">El video solo se carga si el estudiante lo pide, para ahorrar datos.</div></div>
  <div class="row">
    <div class="col-4 mb-3"><label class="form-label" for="minutos">Minutos</label><input id="minutos" name="minutos" type="number" min="1" max="60" class="form-control" value="<%= l.minutos || 5 %>"></div>
    <div class="col-4 mb-3"><label class="form-label" for="orden">Orden</label><input id="orden" name="orden" type="number" min="1" class="form-control" value="<%= l.orden || 1 %>"></div>
    <div class="col-4 mb-3 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="publicado" value="si" id="publicado" <%= l.publicado ? 'checked' : '' %>><label class="form-check-label" for="publicado">Publicar</label></div></div>
  </div>
  <button class="btn btn-primary">Guardar lección</button>
  <a class="btn btn-link" href="/facilitador/modulos/<%= m.id_modulo %>">Cancelar</a>
</form>
<% if (l.id_leccion) { %>
<form method="post" action="/facilitador/lecciones/<%= l.id_leccion %>/eliminar" class="mt-3 confirmar" data-confirmar="¿Eliminar la lección y sus actividades?">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-danger btn-sm">Eliminar lección</button>
</form>
<% } %>
<%- include('../partials/pie') %>
