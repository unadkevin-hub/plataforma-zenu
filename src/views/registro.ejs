<%- include('partials/cabecera') %>
<div class="mx-auto" style="max-width:560px">
  <h1 class="h3 mb-3">Crear cuenta</h1>
  <%- include('partials/errores', { errores }) %>
  <form method="post" action="/registro" class="tarjeta p-4" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="mb-3">
      <label for="alias" class="form-label">Alias</label>
      <input id="alias" name="alias" class="form-control" required minlength="3" maxlength="30" autocomplete="username" value="<%= datos.alias || '' %>" aria-describedby="ayuda-alias">
      <div id="ayuda-alias" class="form-text">Un nombre inventado, por ejemplo <em>tigre_sabanero</em>. No uses tu nombre completo.</div>
    </div>
    <fieldset class="mb-3">
      <legend class="form-label fs-6">Rango de edad</legend>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="rango_edad" id="r1517" value="15-17" <%= datos.rango_edad === '15-17' ? 'checked' : '' %>>
        <label class="form-check-label" for="r1517">15 a 17 años</label>
      </div>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="rango_edad" id="r1820" value="18-20" <%= datos.rango_edad === '18-20' ? 'checked' : '' %>>
        <label class="form-check-label" for="r1820">18 a 20 años</label>
      </div>
    </fieldset>
    <div class="mb-3">
      <label for="contrasena" class="form-label">Contraseña</label>
      <input id="contrasena" name="contrasena" type="password" class="form-control" required minlength="8" autocomplete="new-password" aria-describedby="ayuda-clave">
      <div id="ayuda-clave" class="form-text">Mínimo 8 caracteres, con letras y números. Ejemplo de frase: Caña-Rio-Tigre-27.</div>
    </div>
    <div class="mb-3">
      <label for="confirmar" class="form-label">Repite la contraseña</label>
      <input id="confirmar" name="confirmar" type="password" class="form-control" required autocomplete="new-password">
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" name="acepta_privacidad" value="si" id="acepta_privacidad">
      <label class="form-check-label" for="acepta_privacidad">Leí y acepto el <a href="/privacidad" target="_blank" rel="noopener">aviso de privacidad</a>.</label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" name="acepta_tratamiento" value="si" id="acepta_tratamiento">
      <label class="form-check-label" for="acepta_tratamiento">Autorizo el tratamiento de mis datos (alias, rango de edad y resultados) solo con fines académicos.</label>
    </div>
    <div class="form-check mb-3" id="bloque-menor">
      <input class="form-check-input" type="checkbox" name="asentimiento_menor" value="si" id="asentimiento_menor">
      <label class="form-check-label" for="asentimiento_menor">Si tengo entre 15 y 17 años: mi madre, padre o acudiente firmó el consentimiento informado del proyecto.</label>
    </div>
    <button class="btn btn-primary w-100" type="submit">Crear cuenta</button>
    <p class="mt-3 mb-0 text-center">¿Ya tienes cuenta? <a href="/ingresar">Ingresa aquí</a></p>
  </form>
</div>
<%- include('partials/pie') %>
